{
  "name": "siddhrans-website",
  "version": "1.0.0",
  "private": true,
  "description": "Siddhrans InfoTech Pvt Ltd corporate website (Next.js static export) and contact API",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "serve": "serve out -l 4173 --no-clipboard",
    "api": "node server/index.mjs",
    "test:api": "node --test server/contact.test.mjs",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify:logo": "node scripts/verify-logo.mjs",
    "check": "npm run typecheck && npm run build && npm run verify:logo && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "next": "^16.4.2",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "typescript": "^7.0.2"
  }
}
